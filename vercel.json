{
  "headers": [
    {
      "source": "/download/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/download",
      "destination": "/download/index.html"
    },
    {
      "source": "/download/",
      "destination": "/download/index.html"
    },
    {
      "source": "/download/:file",
      "destination": "/download/:file"
    },
    {
      "source": "/legal/(.*)",
      "destination": "/legal/$1"
    },
    {
      "source": "/support/(.*)",
      "destination": "/support/$1"
    },
    {
      "source": "/feedback/(.*)",
      "destination": "/feedback/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
